-- Tạo ScreenGui
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "UserAliasUI"
screenGui.Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui")

-- Tạo Frame chính (Bảng menu)
local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 300, 0, 200)
frame.Position = UDim2.new(0.5, -150, 0.5, -100)
frame.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
frame.BorderSizePixel = 0
frame.Parent = screenGui

-- Bo góc cho Frame
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 10)
corner.Parent = frame

-- Ô nhập Username
local userBox = Instance.new("TextBox")
userBox.Size = UDim2.new(0, 250, 0, 40)
userBox.Position = UDim2.new(0.5, -125, 0.2, 0)
userBox.PlaceholderText = "Nhập Username..."
userBox.Text = ""
userBox.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
userBox.TextColor3 = Color3.new(1, 1, 1)
userBox.Parent = frame

-- Ô nhập Alias (Biệt hiệu)
local aliasBox = Instance.new("TextBox")
aliasBox.Size = UDim2.new(0, 250, 0, 40)
aliasBox.Position = UDim2.new(0.5, -125, 0.45, 0)
aliasBox.PlaceholderText = "Nhập Alias (Biệt danh)..."
aliasBox.Text = ""
aliasBox.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
aliasBox.TextColor3 = Color3.new(1, 1, 1)
aliasBox.Parent = frame

-- Nút Xác nhận
local submitBtn = Instance.new("TextButton")
submitBtn.Size = UDim2.new(0, 100, 0, 40)
submitBtn.Position = UDim2.new(0.5, -50, 0.75, 0)
submitBtn.Text = "XÁC NHẬN"
submitBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 127)
submitBtn.TextColor3 = Color3.new(1, 1, 1)
submitBtn.Font = Enum.Font.SourceSansBold
submitBtn.Parent = frame

-- Xử lý sự kiện khi nhấn nút
submitBtn.MouseButton1Click:Connect(function()
	local username = userBox.Text
	local alias = aliasBox.Text
	
	if username ~= "" and alias ~= "" then
		print("--- Thông tin đã nhận ---")
		print("Username: " .. username)
		print("Alias: " .. alias)
		
		-- Thông báo cho người dùng (tùy chọn)
		submitBtn.Text = "Thành công!"
		wait(1)
		submitBtn.Text = "XÁC NHẬN"
	else
		warn("Vui lòng nhập đầy đủ thông tin!")
	end
end)
